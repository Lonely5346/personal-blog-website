---
import { SITE } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  page?: boolean;
  hideHero?: boolean;
  heroTitle?: string;
  heroSubtitle?: string;
}

const {
  title,
  description = SITE.description,
  page = false,
  hideHero = false,
  heroTitle,
  heroSubtitle,
} = Astro.props;

const pageTitle = title ? `${title} - ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content="Astro" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4a6b8" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.title} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} RSS`}
      href="/rss.xml"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />

    {
      !hideHero && (
        <section class="hero">
          <div class="hero-blob b1"></div>
          <div class="hero-blob b2"></div>
          <div class="hero-blob b3"></div>
          <div class="container">
            {
              page ? (
                <>
                  <h1 class="hero-title">{heroTitle}</h1>
                  {heroSubtitle && <p class="hero-subtitle">{heroSubtitle}</p>}
                </>
              ) : (
                <>
                  <h1 class="hero-title">{SITE.title}</h1>
                  <p class="hero-subtitle">{SITE.subtitle}</p>
                  <p class="hero-slogan">{SITE.slogan}</p>
                  <form class="hero-search" action="/search" method="get" role="search">
                    <input
                      type="search"
                      name="q"
                      placeholder="搜索文章…"
                      aria-label="搜索文章"
                      autocomplete="off"
                    />
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                  </form>
                </>
              )
            }
          </div>
        </section>
      )
    }

    <slot />

    <Footer />
    <script>
      // 主题初始化：优先读取本地存储，其次跟随系统
      function getStoredTheme() {
        try {
          return localStorage.getItem("theme");
        } catch {
          return null;
        }
      }
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const theme = getStoredTheme() || (prefersDark ? "dark" : "light");
      document.documentElement.dataset.theme = theme;
    </script>
  </body>
</html>
