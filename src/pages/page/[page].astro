---
export const prerender = true;
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import Sidebar from "../../components/Sidebar.astro";
import { SITE } from "../../config";
import { sortByDate } from "../../utils";

export async function getStaticPaths() {
  const all = await getCollection("posts", ({ data }) => !data.draft);
  const sorted = sortByDate(all);
  const totalPages = Math.max(1, Math.ceil(sorted.length / SITE.pageSize));
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { sorted },
  }));
}

const { page = "2" } = Astro.params;
const { sorted } = Astro.props;
const current = Number(page);
const pageSize = SITE.pageSize;
const posts = sorted.slice((current - 1) * pageSize, current * pageSize);
const totalPages = Math.max(1, Math.ceil(sorted.length / pageSize));

function pageUrl(p: number) {
  return p === 1 ? "/" : `/page/${p}/`;
}
---

<Layout>
  <main class="container">
    <div class="layout-main">
      <section>
        {
          posts.map((post) => (
            <PostCard post={post} />
          ))
        }
        <nav class="pagination" aria-label="分页">
          {current > 1 && <a href={pageUrl(current - 1)}>← 上一页</a>}
          {
            Array.from({ length: totalPages }, (_, i) => i + 1).map((p) =>
              p === current ? (
                <span class="current" aria-current="page">{p}</span>
              ) : (
                <a href={pageUrl(p)}>{p}</a>
              )
            )
          }
          {current < totalPages && <a href={pageUrl(current + 1)}>下一页 →</a>}
        </nav>
      </section>

      <Sidebar posts={sorted} />
    </div>
  </main>
</Layout>
