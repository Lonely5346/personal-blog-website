---
import { SITE, SOCIAL } from "../config";
import type { Post } from "../utils";
import { collectTags, formatDate, sortByDate } from "../utils";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const sorted = sortByDate(posts);
const tags = collectTags(sorted);
const recent = sorted.slice(0, 6);

// 简单按月归档
const archive = new Map<string, number>();
for (const p of sorted) {
  const key = `${p.data.date.getFullYear()}-${String(p.data.date.getMonth() + 1).padStart(2, "0")}`;
  archive.set(key, (archive.get(key) ?? 0) + 1);
}
---

<aside class="sidebar">
  <div class="widget widget-author">
    <img class="avatar" src={SITE.avatar} alt={SITE.author} />
    <div class="name">{SITE.author}</div>
    <p class="desc">{SITE.subtitle}</p>
    <div class="socials">
      <a href={SOCIAL.github} target="_blank" rel="noopener" title="GitHub" aria-label="GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.66.8.55A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
      </a>
      <a href={`mailto:${SOCIAL.email}`} title="邮箱" aria-label="邮箱">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m2 7 10 7L22 7"/></svg>
      </a>
      <a href={SOCIAL.rss} title="RSS 订阅" aria-label="RSS">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4 11a9 9 0 0 1 9 9h-3a6 6 0 0 0-6-6v-3zm0-7a16 16 0 0 1 16 16h-3a13 13 0 0 0-13-13V4zm0 14a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/></svg>
      </a>
    </div>
  </div>

  <div class="widget">
    <h3>📂 归档</h3>
    <ul>
      {
        [...archive.entries()]
          .sort((a, b) => b[0].localeCompare(a[0]))
          .slice(0, 8)
          .map(([month, count]) => (
            <li>
              <a href={`/archive#${month}`}>{month}</a>
              <span class="count">{count} 篇</span>
            </li>
          ))
      }
    </ul>
  </div>

  <div class="widget">
    <h3>🏷️ 标签云</h3>
    <div class="tag-cloud">
      {
        tags.slice(0, 20).map(([tag, count]) => (
          <a href={`/tags/${tag}/`} title={`${count} 篇文章`}>#{tag}</a>
        ))
      }
    </div>
  </div>

  <div class="widget">
    <h3>🕐 最新文章</h3>
    <ul>
      {
        recent.map((p) => (
          <li>
            <a href={`/posts/${p.id}/`}>{p.data.title}</a>
            <span class="count">{formatDate(p.data.date).slice(5)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
